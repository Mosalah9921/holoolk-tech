# انسخ الملف ده باسم .env.local وحط القيم الحقيقية (ولما تنشر على Vercel حطها في Settings → Environment Variables)

# Google Analytics 4 — من analytics.google.com (شكله G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Facebook / Meta Pixel — من Events Manager (رقم طويل)
NEXT_PUBLIC_FB_PIXEL_ID=

# استقبال طلبات نموذج التواصل على الإيميل (اختياري)
# اعمل نموذج مجاني على formspree.io وحط رابطه هنا: https://formspree.io/f/xxxxxxx
NEXT_PUBLIC_FORM_ENDPOINT=
